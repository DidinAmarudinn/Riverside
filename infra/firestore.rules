rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Clients may only read live signals; all writes come from the API (Admin SDK).
    match /signals_live/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
