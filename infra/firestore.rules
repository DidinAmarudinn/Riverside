rules_version = '2';
// Contract: docs/api-contract.md §2. Clients only read; the API writes with the Admin SDK.
service cloud.firestore {
  match /databases/{database}/documents {
    // Base data, shared by every visitor.
    match /recommendations/{doc} {
      allow read: if true;
    }
    match /metrics/{doc} {
      allow read: if true;
    }

    // Per-visitor sandbox. The sandbox id is a random UUID kept by the visitor's browser.
    match /sandboxes/{sandboxId} {
      allow read: if true;
      match /{collection}/{doc} {
        allow read: if collection != 'sessions';
      }
      // Chat history and agent state stay backend-only.
      match /sessions/{document=**} {
        allow read: if false;
      }
    }

    // Everything else, and every client write, is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
