{
  "firestore": { "rules": "firestore.rules" },
  "hosting": {
    "public": "../apps/web/dist",
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [
      { "source": "/api/**", "run": { "serviceId": "demand-radar-api", "region": "us-central1" } },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
