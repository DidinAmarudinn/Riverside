{
  "firestore": {
    "rules": "infra/firestore.rules"
  },
  "hosting": {
    "public": "apps/web/out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "demand-radar-api",
          "region": "us-central1"
        }
      }
    ]
  }
}
