# --- Google Cloud ---
GCP_PROJECT=
GCP_LOCATION=us-central1
BQ_DATASET=demand_radar
GOOGLE_GENAI_USE_VERTEXAI=TRUE        # ADK / google-genai talk to Vertex AI
GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_BUDGET=0               # 0 = thinking off (faster); -1 = model default
GEMINI_WORKERS=8                       # parallel Gemini calls in the batch extractor
# GEMINI_API_KEY=                      # optional: use an API key instead of Vertex AI/ADC
PUBSUB_TOPIC=conversations
PUBSUB_AUDIENCE=                       # Cloud Run URL of demand-radar-api (OIDC check on /pubsub/extract)

# --- API ---
DATA_BACKEND=local                     # local = CSVs in data/out (make sim) | gcp = BigQuery dataset BQ_DATASET
AGENT_SQL_SA=                          # e.g. dr-agent-sql@<project>.iam.gserviceaccount.com; query_data impersonates it (needs tokenCreator)
PUBLISHER=local                        # local = in memory | pubsub = topic PUBSUB_TOPIC (create it first)
# DATA_DIR=                            # default: <repo>/data (needs data/out from `make sim`)
CORS_ORIGINS=http://localhost:3000

# --- Web (apps/web/.env.local; see apps/web/.env.example) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
