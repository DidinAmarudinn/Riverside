# --- Google Cloud ---
GCP_PROJECT=
GCP_LOCATION=us-central1
BQ_DATASET=demand_radar
GOOGLE_GENAI_USE_VERTEXAI=TRUE        # ADK / google-genai talk to Vertex AI
GEMINI_MODEL=gemini-2.5-flash
GEMINI_WORKERS=8                       # parallel Gemini calls in the batch extractor
# GEMINI_API_KEY=                      # optional: use an API key instead of Vertex AI/ADC
PUBSUB_TOPIC=conversations
PUBSUB_AUDIENCE=                       # Cloud Run URL of demand-radar-api (OIDC check on /pubsub/extract)

# --- API ---
DATA_BACKEND=local                     # local | gcp
CORS_ORIGINS=http://localhost:5173

# --- Web (apps/web/.env.local) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
