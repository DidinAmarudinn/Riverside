# Data mode: "mock" (default, no backend) or "live" (calls /api/**).
NEXT_PUBLIC_DATA_MODE=mock

# Default store selected on first load.
NEXT_PUBLIC_DEFAULT_STORE_ID=S01

# Only used by `next dev` to proxy /api/** -> Cloud Run (no effect on export).
NEXT_PUBLIC_API_PROXY_TARGET=http://localhost:8080

# Optional links shown on the jury page (hidden/disabled when empty).
NEXT_PUBLIC_VIDEO_URL=
NEXT_PUBLIC_GITHUB_URL=

# Optional multimodal kiosk features (camera / mic). Disabled by default.
NEXT_PUBLIC_FEATURE_MULTIMODAL=false

# Firestore realtime in live mode (alerts, live feed, KPIs, demo state).
# Web app config from Firebase console; public by design (rules are read-only).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
